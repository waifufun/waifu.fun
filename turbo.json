{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		".env",
		".env.*",
		".env.example",
		"biome.json",
		"package.json",
		"bun.lock",
		"tsconfig.node.base.json"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"check": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build", "build"],
			"outputs": [],
			"env": [
				"FORK_BSC",
				"FORK_BSC_URL",
				"FORK_BSC_BLOCK",
				"REQUIRE_BSC_FORK",
				"BSC_RPC",
				"BSCSCAN_API_KEY",
				"DEPLOYER"
			]
		},
		"lint": {
			"outputs": []
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"clean": {
			"dependsOn": ["^clean"],
			"cache": false
		}
	}
}
