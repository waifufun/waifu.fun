{
	"name": "@autofun/monorepo",
	"repository": {
		"url": "https://github.com/elizaos/autofun-monorepo",
		"type": "github"
	},
	"type": "module",
	"private": true,
	"pnpm": {
		"supportedArchitectures": {
			"os": [
				"current"
			],
			"cpu": [
				"x64",
				"arm64"
			]
		},
		"ignoredBuiltDependencies": [
			"@biomejs/biome",
			"@bufbuild/buf",
			"@tailwindcss/oxide",
			"bigint-buffer",
			"blake-hash",
			"bufferutil",
			"core-js-pure",
			"es5-ext",
			"esbuild",
			"keccak",
			"protobufjs",
			"secp256k1",
			"sharp",
			"tiny-secp256k1",
			"usb",
			"utf-8-validate"
		]
	},
	"release": {
		"branches": [
			"main",
			{
				"name": "staging",
				"channel": "staging",
				"prerelease": true
			}
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/changelog",
			"@semantic-release/github",
			[
				"@semantic-release/git",
				{
					"assets": [
						"CHANGELOG.md",
						"package.json"
					],
					"message": "chore(release): ${nextRelease.version}"
				}
			]
		]
	},
	"scripts": {
		"build": "NODE_ENV=production pnpm -r --stream build",
		"dev": "./scripts/local-development.sh && dotenv -e .env -- cross-env NODE_ENV=development pnpm -r --parallel run dev",
		"dev:windows": "sh ./scripts/local-development.sh && dotenv -e .env -- cross-env NODE_ENV=development pnpm -r --parallel run dev",
		"docker:up": "docker compose up -d && exit 0",
		"docker:down": "docker compose down",
		"docker:kill": "docker compose down -v",
		"lint": "NODE_OPTIONS=\"--max-old-space-size=8096\" pnpm -r --stream --parallel lint",
		"run:indexer": "docker-compose -f docker-compose.indexer.yml up -d && sleep 3 && cd apps/indexer && pnpm install && pnpm run build && pnpm run db:migrate && pnpm run start",
		"kill:indexer": "pkill -f 'sqd' || true && docker-compose -f docker-compose.indexer.yml down",
		"kill:indexer:hard": "pkill -f 'sqd' || true && docker-compose -f docker-compose.indexer.yml down -v",
		"reset:indexer": "pnpm kill:indexer:hard && pnpm run:indexer"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.2",
		"cross-env": "^7.0.3",
		"dotenv-cli": "^8.0.0",
		"esbuild": "^0.25.4",
		"semantic-release": "^24.2.3",
		"tsx": "^4.15.1",
		"typescript": "^5.4.5"
	},
	"packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
