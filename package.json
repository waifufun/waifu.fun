{
	"name": "@autofun/monorepo",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"pnpm": {
		"supportedArchitectures": {
			"os": [
				"current"
			],
			"cpu": [
				"x64",
				"arm64"
			]
		}
	},
	"scripts": {
		"build": "NODE_ENV=production pnpm -r --stream build",
		"dev": "./scripts/local-development.sh && dotenv -e .env -- cross-env NODE_ENV=development pnpm -r --parallel run dev",
		"docker:up": "docker compose up -d && exit 0",
		"docker:down": "docker compose down",
		"lint": "NODE_OPTIONS=\"--max-old-space-size=8096\" pnpm -r --stream --parallel lint"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"cross-env": "^7.0.3",
		"esbuild": "^0.21.5",
		"tsx": "^4.15.1",
		"typescript": "^5.4.5"
	},
	"dependencies": {
		"@reown/appkit": "^1.7.4",
		"@reown/appkit-adapter-wagmi": "^1.7.4",
		"@solana/wallet-adapter-base": "^0.9.26",
		"@solana/wallet-adapter-react": "^0.15.38",
		"@solana/web3.js": "^1.98.2",
		"@tanstack/react-query": "^5.76.0",
		"bs58": "^6.0.0",
		"dotenv-cli": "^8.0.0",
		"viem": "^2.28.3",
		"wagmi": "^2.15.2"
	}
}
