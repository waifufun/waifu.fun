{
	"name": "@waifufun/queue",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./jobs": {
			"types": "./dist/jobs.d.ts",
			"import": "./dist/jobs.js"
		},
		"./catalog": {
			"types": "./dist/catalog.d.ts",
			"import": "./dist/catalog.js"
		}
	},
	"scripts": {
		"prebuild": "bun run --filter @waifufun/redis build",
		"pretypecheck": "bun run --filter @waifufun/redis build",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check src package.json tsconfig.json",
		"clean": "rm -rf dist",
		"precheck": "bun run --filter @waifufun/redis build",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@waifufun/redis": "workspace:*",
		"bullmq": "^5.61.0",
		"ioredis": "5.10.1",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"typescript": "^5.7.2"
	},
	"files": ["dist"]
}
