{
	"name": "@waifufun/metrics",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Prometheus metrics registry and agent metric instruments for waifu services",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./registry": {
			"types": "./dist/registry.d.ts",
			"import": "./dist/registry.js"
		},
		"./counters": {
			"types": "./dist/counters.d.ts",
			"import": "./dist/counters.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check src package.json tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"prom-client": "^15.1.3"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"typescript": "^5.7.2"
	}
}
