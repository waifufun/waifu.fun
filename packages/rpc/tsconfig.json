{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// explicit strict mode
		"strict": true,

		// output directory
		"outDir": "dist",
		"rootDir": "src",

		// path aliases
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},

		// build configuration - use NodeNext for better ESM/CJS interop
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"], // ["DOM", "DOM.Iterable"],

		// preserve jsdoc comments for intellisense
		"removeComments": false,

		// generate types and their sourcemaps
		"declaration": true,
		"declarationMap": true,

		// linting
		"strictFunctionTypes": true
	},
	"include": ["../../reset.d.ts", "src/**/*.d.ts", "src/**/*.ts"],
	"exclude": ["dist", "node_modules", "test", "src/**/*.spec.ts", "src/**/*.test.ts", "src/**/test/**"]
}
