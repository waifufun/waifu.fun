{
	"name": "@waifufun/migrations",
	"version": "1.0.0",
	"description": "Migration service for Autofun",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "rimraf dist && tsc",
		"start": "tsx src/scripts/run-service.ts",
		"dev": "nodemon --watch src --ext ts,tsx --exec \"tsx src/scripts/run-service.ts\"",
		"test": "mocha --require tsx --require ./src/tests/test-setup.ts --require ./src/tests/setup.ts \"src/tests/**/*.test.ts\"",
		"test:windows": "node \"./node_modules/.bin/mocha\" --loader ts-node/esm --extensions ts,tsx --file src/tests/test-setup.ts --file src/tests/setup.ts src/tests/**/*.test.ts",
		"lint": "biome check src package.json tsconfig.json",
		"clean": "rimraf dist",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@waifufun/database": "workspace:*",
		"@waifufun/logger": "workspace:*",
		"@waifufun/redis": "workspace:*",
		"@waifufun/types": "workspace:*",
		"@waifufun/programs": "workspace:*",
		"@coral-xyz/anchor": "^0.31.1",
		"@solana/web3.js": "^1.91.1",
		"dotenv": "^16.5.0",
		"@meteora-ag/cp-amm-sdk": "^1.0.2",
		"@raydium-io/raydium-sdk-v2": "^0.1.138-alpha",
		"@solana/spl-token": "^0.3.9",
		"decimal.js": "^10.5.0",
		"bn.js": "^5.2.2",
		"mongoose": "^8.14.1"
	},
	"devDependencies": {
		"@types/bn.js": "5.1.6",
		"@types/chai": "^5.2.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.29",
		"@types/sinon": "^17.0.4",
		"@types/sinon-chai": "^4.0.0",
		"chai": "^5.2.0",
		"mocha": "^10.2.0",
		"nodemon": "^3.1.10",
		"rimraf": "^5.0.1",
		"sinon": "^15.1.0",
		"sinon-chai": "^4.0.0",
		"ts-node": "^10.9.2",
		"tsx": "^4.7.1",
		"typescript": "^5.1.6"
	}
}
