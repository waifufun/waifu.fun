{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": ["mocha", "chai", "node"],
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "Node",
		"allowSyntheticDefaultImports": true,
		"target": "ESNext"
	},
	"include": ["src/tests/**/*"],
	"ts-node": {
		"esm": true,
		"experimentalSpecifierResolution": "node"
	}
}
