# --- Deployment ---
DEPLOYER=<private_key>
BSC_RPC=https://bsc-dataseed1.binance.org/
BSCSCAN_API_KEY=<key>
ETH_RPC=http://127.0.0.1:8545
FORK_BSC=false

# --- Live contracts (post-pivot) ---
# WAIFU ERC20 (platform token; minted via Flap launch)
WAIFU_TOKEN_ADDRESS=<address_from_flap_launch>
# VeWaifuStaking (active; WAIFU token utility)
VEWAIFU_STAKING_ADDRESS=<address_after_deploy>
# Multisig treasury receiving platform fees
PLATFORM_WALLET=<multisig_address>

# --- Four.Meme integration (BSC mainnet) ---
# Reference only; see packages/fourmeme for the runtime client.
FOURMEME_TOKEN_MANAGER2=0x5c952063c7fc8610FFDB798152D69F0B9550762b
FOURMEME_HELPER3=0xF251F83e40a78868FcfA3FA4599Dad6494E46034
FOURMEME_AGENT_IDENTIFIER=0x09B44A633de9F9EBF6FB9Bdd5b5629d3DD2cef13

# --- Deprecated (kept for historical decoding only) ---
