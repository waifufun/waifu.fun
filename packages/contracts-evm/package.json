{
	"name": "@waifufun/contracts-evm",
	"version": "0.0.0",
	"private": true,
	"type": "commonjs",
	"description": "waifu.fun EVM contracts: Wave H launchpad (Flap-native bundle launcher) plus legacy VeWaifuStaking + TreasuryLP4",
	"license": "ISC",
	"scripts": {
		"build": "hardhat compile",
		"compile": "hardhat compile",
		"deploy": "hardhat run scripts/deploy/deploy-wave-h.js",
		"deploy:local": "hardhat run scripts/deploy/deploy-wave-h-local.js --network localhost",
		"test": "hardhat test",
