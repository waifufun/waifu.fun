{
	"name": "@waifufun/contracts-evm",
	"version": "0.0.0",
	"private": true,
	"description": "Restored WaifuFun EVM contracts from the historical evm-contracts branch",
	"license": "ISC",
	"scripts": {
		"compile": "hardhat compile",
		"deploy": "hardhat run scripts/deploy.js",
		"deploy:local": "hardhat run scripts/deploy.js --network localhost",
		"test:contracts": "hardhat test test/Contracts.test.js test/Security.test.js",
		"test:contracts:local": "hardhat test --network localhost test/Contracts.test.js test/Security.test.js",
		"test:e2e": "hardhat test test/E2E.test.js",
		"test:e2e:local": "hardhat test --network localhost test/E2E.test.js",
		"test": "bun run test:contracts && bun run test:e2e",
		"lint": "biome check scripts test hardhat.config.js package.json"
	},
	"devDependencies": {
		"@types/sinon-chai": "^3.2.12",
		"@nomicfoundation/hardhat-network-helpers": "^1.1.2",
		"@nomiclabs/hardhat-ethers": "^2.2.3",
		"@nomiclabs/hardhat-etherscan": "^3.1.7",
		"@nomiclabs/hardhat-waffle": "^2.0.5",
		"@openzeppelin/contracts": "^4.8.3",
		"@openzeppelin/contracts-upgradeable": "^4.8.3",
		"@openzeppelin/hardhat-upgrades": "^1.22.1",
		"chai": "^4.3.7",
		"dotenv": "^16.0.3",
		"ethereum-waffle": "^4.0.10",
		"ethers": "^5.7.2",
		"hardhat": "^2.13.0",
		"hardhat-contract-sizer": "^2.8.0",
		"hardhat-libutils": "^1.0.9",
		"solidity-coverage": "^0.8.2"
	}
}
