{
	"name": "@autofun/programs",
	"type": "module",
	"version": "0.1.0",
	"description": "Autofun programs, IDLs, and types with network detection",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@coral-xyz/anchor": "^0.31.1",
		"@solana/web3.js": "^1.98.2"
	},
	"devDependencies": {
		"@types/node": "^20.10.0",
		"tsup": "^8.0.1",
		"typescript": "^5.3.3"
	},
	"peerDependencies": {
		"@autofun/types": "workspace:*"
	}
}
