{
	"name": "@waifufun/contracts-solana-audit",
	"version": "0.0.0",
	"private": true,
	"description": "Vendored audited Solana Autofun source for reference alongside the canonical WaifuFun IDLs",
	"author": "Carsen Klock",
	"scripts": {
		"lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
		"lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
		"test:contracts": "mocha -r ts-node/register/transpile-only -t 1000000 tests/autofun.ts",
		"test:e2e": "mocha -r ts-node/register/transpile-only -t 1000000 tests/launch_and_swap.ts",
		"test": "pnpm run test:contracts && pnpm run test:e2e",
		"build": "anchor build --no-idl --skip-lint",
		"build:local": "anchor build --no-idl --skip-lint",
		"deploy": "anchor deploy",
		"deploy:local": "anchor deploy"
	},
	"dependencies": {
		"@coral-xyz/anchor": "^0.31.1",
		"@faker-js/faker": "^9.3.0",
		"@metaplex-foundation/mpl-token-metadata": "^3.3.0",
		"@metaplex-foundation/umi": "^0.9.2",
		"@metaplex-foundation/umi-bundle-defaults": "^0.9.2",
		"@pinata/sdk": "^2.1.0",
		"@project-serum/serum": "^0.13.65",
		"@pythnetwork/client": "^2.22.0",
		"@raydium-io/raydium-sdk": "^1.3.1-beta.58",
		"@raydium-io/raydium-sdk-v2": "^0.1.93-alpha",
		"@solana/spl-token": "^0.4.8",
		"@solana/web3.js": "^1.68.0",
		"commander": "^12.1.0",
		"cors": "^2.8.5",
		"decimal.js": "^10.4.3",
		"dotenv": "^16.4.5",
		"express": "^4.21.2",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^8.8.4",
		"p-queue": "^8.0.1",
		"socket.io": "^4.8.1",
		"util": "^0.12.5",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/bn.js": "^5.1.0",
		"@types/bun": "^1.1.14",
		"@types/chai": "^4.3.0",
		"@types/cors": "^2.8.17",
		"@types/mocha": "^9.0.0",
		"@types/node": "^22.10.2",
		"chai": "^4.3.4",
		"mocha": "^10.7.3",
		"prettier": "^2.6.2",
		"ts-node": "^10.9.2",
		"ts-mocha": "^10.0.0",
		"typescript": "^4.3.5"
	}
}
