{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": ["**/dist/**", "**/dist", ".vscode/**", "**/.next", "**/packages/contracts-evm/artifacts/**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"useExhaustiveDependencies": "warn"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "warn"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useNumberNamespace": "warn"
			},
			"a11y": {
				"useSemanticElements": "warn",
				"noLabelWithoutControl": "warn"
			},
			"performance": {
				"noDelete": "off"
			}
		}
	}
}
