{
	"name": "@waifufun/frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"prebuild": "bun run --filter @waifufun/config build && bun run --filter @waifufun/types build && bun run --filter @waifufun/constants build",
		"build": "node scripts/static-export-build.mjs",
		"pages:deploy": "wrangler pages deploy out",
		"lint": "biome format . --write && biome lint . --fix && node scripts/lint-rainbow.mjs",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"build:workers": "tsc -p tsconfig.worker.json",
		"watch:workers": "tsc -p tsconfig.worker.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "tsc -p tsconfig.typecheck.json --noEmit"
	},
	"dependencies": {
		"@bprogress/next": "^3.2.12",
		"@next/third-parties": "^15.3.2",
		"@noble/ed25519": "^2.2.3",
		"@noble/hashes": "^1.8.0",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-popover": "^1.1.13",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.5",
		"@radix-ui/react-tabs": "^1.1.11",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@rainbow-me/rainbowkit": "^2.2.10",
		"@react-native-async-storage/async-storage": "^3.0.2",
		"@simplewebauthn/browser": "^13.3.0",
		"@stwd/react": "0.6.4",
		"@stwd/sdk": "0.7.2",
		"@tanstack/react-query": "^5.77.2",
		"@waifufun/constants": "workspace:*",
		"bs58": "^6.0.0",
		"buffer": "^6.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"crypto-browserify": "^3.12.1",
		"framer-motion": "^12.17.0",
		"lightweight-charts": "^5.0.7",
		"lucide-react": "^0.511.0",
		"moment": "^2.30.1",
		"next": "15.3.9",
		"pino-pretty": "^13.1.3",
		"react": "19.0.0",
		"react-countdown": "^2.3.6",
		"react-dom": "19.0.0",
		"react-hook-form": "^7.56.4",
		"sonner": "^2.0.3",
		"stream-browserify": "^3.0.0",
		"tailwind-merge": "^3.2.0",
		"tailwindcss-animate": "^1.0.7",
		"tailwindcss-animated": "^2.0.0",
		"usehooks-ts": "^3.1.1",
		"viem": "2.47.0",
		"wagmi": "^2.19.5"
	},
	"devDependencies": {
		"@storybook/addon-essentials": "8.6.14",
		"@storybook/addon-links": "8.6.14",
		"@storybook/builder-webpack5": "8.6.14",
		"@storybook/nextjs": "8.6.14",
		"@storybook/react": "8.6.14",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^22.15.23",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/ui": "^4.1.5",
		"@waifufun/types": "workspace:*",
