# syntax=docker/dockerfile:1.4

# ---- Builder Stage ----
FROM oven/bun:1 AS builder

# Set environment variables
ENV NEXT_TELEMETRY_DISABLED=1

# Set working directory
WORKDIR /app

# 1. Copy package manager configuration files
COPY package.json ./

# 2. Copy package.json files for all workspaces
# This helps Docker cache the dependency layer effectively.
COPY apps/*/package.json ./apps/
COPY packages/*/package.json ./packages/

# 3. Copy the entire application source code.
# .dockerignore should prevent node_modules, .next, .env, etc., from being copied.
COPY . .

# 4. Install dependencies using bun.
# This installs dependencies based on the full source code,
# which is important for monorepos with local workspace dependencies.
RUN bun install

# Set build-time environment variables for Next.js
# Default values are provided if not passed during build.
# ENV NEXT_PUBLIC_DECIMALS=${NEXT_PUBLIC_DECIMALS:-9}
# ENV NEXT_PUBLIC_TOKEN_SUPPLY=${NEXT_PUBLIC_TOKEN_SUPPLY:-1000000000}
# ENV NEXT_PUBLIC_VIRTUAL_RESERVES=${NEXT_PUBLIC_VIRTUAL_RESERVES:-1000000}
# ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:3331}
# ENV NEXT_PUBLIC_HOST=${NEXT_PUBLIC_HOST:-localhost}

# 5. Build the Next.js application.
# Using --mount for Next.js build cache (requires BuildKit).
# This speeds up subsequent builds by caching Next.js's internal build artifacts.
RUN --mount=type=cache,target=/app/apps/frontend/.next/cache \
    bun --filter @autofun/frontend build

# ---- Runner Stage ----
FROM node:22 AS runner

WORKDIR /app

# Set environment variables for production
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=${PORT:-3000}
# Example for runtime NEXT_PUBLIC_ variable, if needed:
# ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# Copy the standalone server and its specific node_modules
COPY --from=builder /app/apps/frontend/.next/standalone ./

# Copy the static assets (JS, CSS chunks) from the original .next directory
COPY --from=builder /app/apps/frontend/.next/static ./apps/frontend/.next/static

# Copy the public assets
COPY --from=builder /app/apps/frontend/public ./apps/frontend/public

# Expose the port the app runs on
EXPOSE ${PORT:-3000}

# Define the command to run the application.
# The server.js path is relative to WORKDIR /app.
# For a project in apps/frontend, Next.js standalone output typically places server.js
# at apps/frontend/server.js within the copied standalone bundle.
CMD ["node", "apps/frontend/server.js"]
