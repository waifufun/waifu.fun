# syntax=docker.io/docker/dockerfile:1
FROM node:22-alpine AS builder

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Set working directory
WORKDIR /app

# Copy root package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all package.json files from workspaces
COPY apps/*/package.json ./apps/
COPY packages/*/package.json ./packages/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code (excluding node_modules)
COPY tsconfig.base.json ./
COPY apps/frontend/src ./apps/frontend/src
COPY apps/frontend/public ./apps/frontend/public
COPY apps/frontend/next.config.ts ./apps/frontend/
COPY apps/frontend/tsconfig.json ./apps/frontend/
COPY apps/frontend/workers ./apps/frontend/workers
COPY packages/ai/src ./packages/ai/src
COPY packages/types/src ./packages/types/src

# Set environment variables for build
ENV NEXT_PUBLIC_DECIMALS=9
ENV NEXT_PUBLIC_TOKEN_SUPPLY=1000000000
ENV NEXT_PUBLIC_VIRTUAL_RESERVES=1000000
ENV NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_HOST=localhost

# Build the application
RUN cd apps/frontend && pnpm build

# Production image
FROM node:22-alpine AS runner
WORKDIR /app

# Copy built application
COPY --from=builder /app/apps/frontend/.next/standalone ./
COPY --from=builder /app/apps/frontend/.next/static ./apps/frontend/.next/static
COPY --from=builder /app/apps/frontend/public ./apps/frontend/public

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_PUBLIC_DECIMALS=9
ENV NEXT_PUBLIC_TOKEN_SUPPLY=1000000000
ENV NEXT_PUBLIC_VIRTUAL_RESERVES=1000000
ENV NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_HOST=localhost

# Expose port
EXPOSE 3000

# Start the application
CMD ["node", "apps/frontend/server.js"]
