FROM node:20-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS deps
WORKDIR /app

COPY package.json pnpm-lock.yaml* .npmrc* pnpm-workspace.yaml ./

COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/blank/package.json ./packages/blank/package.json
COPY packages/constants/package.json ./packages/constants/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/logger/package.json ./packages/logger/package.json
COPY packages/redis/package.json ./packages/redis/package.json
COPY packages/rpc/package.json ./packages/rpc/package.json
COPY packages/s3-uploader/package.json ./packages/s3-uploader/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/utils/package.json ./packages/utils/package.json

RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app

COPY . .

COPY --from=deps /app/node_modules ./node_modules

RUN pnpm install --frozen-lockfile --prefer-offline

ENV NEXT_TELEMETRY_DISABLED=1

RUN --mount=type=cache,id=nextjs-cache,target=/app/apps/frontend/.next/cache \
    pnpm --filter frontend run build

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/.next/standalone/ ./

USER nextjs

EXPOSE 3000
ENV PORT=3000

CMD ["node", "/app/apps/frontend/.next/standalone/server.js"]
