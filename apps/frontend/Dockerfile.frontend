# syntax=docker.io/docker/dockerfile:1

FROM node:20 AS base

# Install dependencies only when needed
FROM base AS deps
# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
#RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install dependencies based on the preferred package manager
# Copy monorepo root configuration files necessary for pnpm workspaces
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* .npmrc* ./

# Copy other root configuration files that might be needed by workspace packages during install
COPY tsconfig.base.json ./
# If biome.json is at root and relevant for install/linking, copy it too:
# COPY biome.json ./

# Copy application's source code and all local workspace packages' source code
# This allows pnpm to correctly build the dependency graph and symlinks for the workspace
COPY apps/frontend ./apps/frontend
COPY packages ./packages

# Install dependencies
RUN corepack enable pnpm && pnpm i --filter @autofun/frontend --frozen-lockfile

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app

# Copy monorepo root configuration files necessary for pnpm to identify the workspace and run build scripts
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* .npmrc* ./
COPY tsconfig.base.json ./ # Ensure tsconfig.base.json is available in the builder stage root
# If biome.json is at root and needed by build scripts (e.g. lint step in build), copy it too:
# COPY biome.json ./

COPY --from=deps /app/node_modules ./node_modules

# Copy the application source code and local workspace packages' source code from the 'deps' stage
# This ensures consistency with the node_modules built in the 'deps' stage.
COPY --from=deps /app/apps/frontend ./apps/frontend
COPY --from=deps /app/packages ./packages

# Root configuration files like tsconfig.base.json (and biome.json if used for build) are copied above.

# Next.js collects completely anonymous telemetry data about general usage.
# Learn more here: https://nextjs.org/telemetry
# Uncomment the following line in case you want to disable telemetry during the build.
# ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable pnpm && pnpm --filter @autofun/frontend run build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
# Uncomment the following line in case you want to disable telemetry during runtime.
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy public assets from the frontend app's build output
COPY --from=builder /app/apps/frontend/public ./public

# Automatically leverage output traces to reduce image size
# https://nextjs.org/docs/advanced-features/output-file-tracing
# The .next/standalone and .next/static paths are relative to the app's location in the builder stage
COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000

# server.js is created by next build from the standalone output
# https://nextjs.org/docs/pages/api-reference/config/next-config-js/output
ENV HOSTNAME="0.0.0.0"
# The server.js path is relative to the WORKDIR /app
# and reflects the nested structure within the standalone output for monorepos.
CMD ["node", "apps/frontend/server.js"]
