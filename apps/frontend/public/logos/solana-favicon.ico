tion\":3,\"resourceId\":{\"kind\":\"youtube#video\",\"videoId\":\"vRVC0aLCUnU\"},\"videoOwnerChannelTitle\":\"Solana\",\"videoOwnerChannelId\":\"UC9AdQPUe4BdVJ8M9X7wxHUA\"},\"contentDetails\":{\"videoId\":\"vRVC0aLCUnU\",\"videoPublishedAt\":\"2025-12-27T18:00:59Z\"}},{\"kind\":\"youtube#playlistItem\",\"etag\":\"DIRR0BYz3p8kILeQabASDwCQ0c0\",\"id\":\"UExpbHdMZUJ3R3VLNnAzcEItdlVRZjFUamtYNDhqMEFmLS5ENDU4Q0M4RDExNzM1Mjcy\",\"snippet\":{\"publishedAt\":\"2025-12-26T19:32:56Z\",\"channelId\":\"UC9AdQPUe4BdVJ8M9X7wxHUA\",\"title\":\"Solana Stories: 2025\",\"description\":\"\",\"thumbnails\":{\"default\":{\"url\":\"https://i.ytimg.com/vi/EkHDd957SPE/default.jpg\",\"width\":120,\"height\":90},\"medium\":{\"url\":\"https://i.ytimg.com/vi/EkHDd957SPE/mqdefault.jpg\",\"width\":320,\"height\":180},\"high\":{\"url\":\"https://i.ytimg.com/vi/EkHDd957SPE/hqdefault.jpg\",\"width\":480,\"height\":360},\"standard\":{\"url\":\"https://i.ytimg.com/vi/EkHDd957SPE/sddefault.jpg\",\"width\":640,\"height\":480},\"maxres\":{\"url\":\"https://i.ytimg.com/vi/EkHDd957SPE/maxresdefault.jpg\",\"width\":1280,\"height\":720}},\"channelTitle\":\"Solana\",\"playlistId\":\"PLilwLeBwGuK6p3pB-vUQf1TjkX48j0Af-\",\"position\":4,\"resourceId\":{\"kind\":\"youtube#video\",\"videoId\":\"EkHDd957SPE\"},\"videoOwnerChannelTitle\":\"Solana\",\"videoOwnerChannelId\":\"UC9AdQPUe4BdVJ8M9X7wxHUA\"},\"contentDetails\":{\"videoId\":\"EkHDd957SPE\",\"videoPublishedAt\":\"2025-12-26T19:34:12Z\"}}],\"news\":[{\"id\":\"payments-on-solana-production-ready-ecosystem-webinar\",\"published\":\"26 Feb 2026\",\"title\":\"Webinar Recap: Payments on Solana - A Production-Ready Ecosystem\",\"tags\":[\"Payments\",\"Finance\",\"Solana Pay\",\"Partner\",\"Ecosystem\"],\"categories\":[\"Payments\"],\"url\":\"/news/payments-on-solana-production-ready-ecosystem-webinar\",\"description\":\"Recap of the \\\"Payments on Solana\\\" webinar featuring Sheraz Shere and Ilan Gitter, covering why Visa, PayPal, and Worldpay are building on Solana across treasury management, remittances, neobanking, payouts, and merchant settlement.\",\"heroImage\":\"/uploads/builder/payments-on-solana-production-ready-ecosystem-webinar/payments-webinar.webp\",\"author\":{\"name\":\"Solana Foundation\",\"avatar\":\"/uploads/authors/solanaLogoMark.svg\"},\"cursor\":\"payments-on-solana-production-ready-ecosystem-webinar\"},{\"id\":\"matrixdock-xaum-launch\",\"published\":\"10 Feb 2026\",\"title\":\"Matrixdock Brings XAUm to Solana, Expanding Institutional-Grade Tokenized Gold Access\",\"tags\":[\"Defi\",\"Finance\",\"Blockchain\",\"Partner\",\"Solana Foundation\"],\"categories\":[\"DeFi\",\"Finance\"],\"url\":\"/news/matrixdock-xaum-launch\",\"description\":\"Matrixdock deploys XAUm, Asia's largest tokenized gold product, on Solana, enabling institutional-grade tokenized gold with near-instant settlement and DeFi integration.\",\"heroImage\":\"/uploads/builder/matrixdock-xaum-launch/matrixdock.webp\",\"author\":{\"name\":\"Solana Foundation\",\"avatar\":\"/uploads/authors/solanaLogoMark.svg\"},\"cursor\":\"matrixdock-xaum-launch\"},{\"id\":\"solana-network-upgrades\",\"published\":\"03 Feb 2026\",\"title\":\"Solana Network Upgrades\",\"tags\":[\"Announcements\"],\"categories\":[\"Finance\",\"Upgrades\"],\"url\":\"/news/solana-network-upgrades\",\"description\":\"A regularly-updated page giving the status of upgrades to the Solana network: Alpenglow, 100M CUs, SIMD 123, and more.\",\"heroImage\":\"/uploads/posts/solana-network-upgrades/ec9179222f514efd84eb1643f68f42b3.png\",\"author\":{\"name\":\"Solana Foundation\",\"avatar\":\"/uploads/authors/solanaLogoMark.svg\"},\"cursor\":\"solana-network-upgrades\"},{\"id\":\"wisdomtree-tokenization-solana\",\"published\":\"28 Jan 2026\",\"title\":\"WisdomTree Expands Tokenization Ecosystem to Solana\",\"tags\":[\"Announcements\",\"Defi\",\"Ecosystem\",\"Finance\",\"Token\",\"Partner\"],\"categories\":[\"Finance\",\"Institutions\"],\"url\":\"/news/wisdomtree-tokenization-solana\",\"description\":\"Today, WisdomTree brings its full suite of regulated tokenized funds to Solana. Both institutional and retail investors can now access money market, equities, fixed income, alternatives, and asset allocation via WisdomTree Connect and WisdomTree Prime.\",\"heroImage\":\"/uploads/posts/wisdomtree-tokenization-solana/wisdom-tree.webp\",\"author\":{\"name\":\"Solana Foundation\",\"avatar\":\"/uploads/authors/solanaLogoMark.svg\"},\"cursor\":\"wisdomtree-tokenization-solana\"},{\"id\":\"solana-foundation-delegation-program-case-study\",\"published\":\"26 Jan 2026\",\"title\":\"The Solana Foundation Delegation Program\",\"tags\":[\"Solana Foundation\",\"Decentralization\",\"Reports\",\"Featured\"],\"categories\":[\"Ecosystem\"],\"url\":\"/news/solana-foundation-delegation-program-case-study\",\"description\":\"A Case Study on Validator Bootstrapping, Incentive Design, and Exit\",\"heroImage\":\"/uploads/posts/sfdp-monitoring/solana-sfdp.webp\",\"author\":{\"name\":\"Waddah Aldrobi\",\"avatar\":\"/uploads/authors/waddah-aldrobi.jpeg\"},\"cursor\":\"solana-foundation-delegation-program-case-study\"},{\"id\":\"ondo-global-markets-tokenized-stocks-etfs-solana\",\"published\":\"21 Jan 2026\",\"title\":\"Ondo Global Markets: Access 200+ Tokenized U.S. Stocks and ETFs on Solana\",\"tags\":[\"Defi\",\"Finance\",\"Ecosystem\",\"Partner\"],\"categories\":[\"DeFi\"],\"url\":\"/news/ondo-global-markets-tokenized-stocks-etfs-solana\",\"description\":\"Ondo Global Markets expands to Solana, offering over 200 tokenized U.S. stocks and ETFs onchain, becoming the largest real-world asset issuer on the network.\",\"heroImage\":\"/uploads/builder/ondo-global-markets-tokenized-stocks-etfs-solana/solana-ondo.webp\",\"author\":{\"name\":\"Solana Foundation\",\"avatar\":\"/uploads/authors/solanaLogoMark.svg\"},\"cursor\":\"ondo-global-markets-tokenized-stocks-etfs-solana\"},{\"id\":\"solana-fireblocks-institutional-treasury-infrastructure\",\"published\":\"20 Jan 2026\",\"title\":\"Solana x Fireblocks: Institutional-Grade Treasury Infrastructure That Moves at Internet Speed\",\"tags\":[\"Finance\",\"Partner\",\"Defi\",\"Ecosystem\",\"Stable Coin\"],\"categories\":[\"Institutions\",\"Finance\"],\"url\":\"/news/solana-fireblocks-institutional-treasury-infrastructure\",\"description\":\"Discover how Solana and Fireblocks combine to deliver enterprise treasury operations with high-throughput blockchain performance, sub-cent transaction costs, and institutional-grade security controls.\",\"heroImage\":\"/uploads/builder/solana-fireblocks-institutional-treasury-infrastructure/solana-fireblocks.webp\",\"author\":{\"name\":\"Solana Foundation\",\"avatar\":\"/uploads/authors/solanaLogoMark.svg\"},\"cursor\":\"solana-fireblocks-institutional-treasury-infrastructure\"},{\"id\":\"understanding-proprietary-amms\",\"published\":\"20 Jan 2026\",\"title\":\"Understanding Proprietary AMMs\",\"tags\":[\"Defi\",\"Tech\",\"Smart Contracts\",\"Ecosystem\"],\"categories\":[\"DeFi\"],\"url\":\"/news/understanding-proprietary-amms\",\"description\":\"A guide to how PropAMMs solve the fundamental problem of market making on-chain.\",\"heroImage\":\"/uploads/posts/propamm-explainer/prop-amms.webp\",\"author\":{\"name\":\"Brian Li\",\"avatar\":\"/uploads/authors/brian-li.jpeg\"},\"cursor\":\"understanding-proprietary-amms\"},{\"id\":\"solana-x-usdt0-case-study-2025\",\"published\":\"09 Jan 2026\",\"title\":\"Solving Liquidity Fragmentation: How Legacy Mesh and Solana Unified $175B in Global USDT\",\"tags\":[\"Case Studies\",\"Defi\",\"Stable Coin\",\"Tether\",\"Solana\"],\"categories\":[\"Finance\",\"Ecosystem\"],\"url\":\"/news/solana-x-usdt0-case-study-2025\",\"description\":\"In October 2025, Solana became directly connected to global, omnichain USDT liquidity via USDT0's new Legacy Mesh infrastructure. Stablecoins power a large portion of onchain finance, but their value is fragmented across blockchains. While distribution offers choice, it creates friction and operational cost, especially for institutions and applications that rely on deep, native liquidity.\",\"heroImage\":\"/uploads/posts/solana-x-usdt0-case-study-2025/how_legacy_mesh_and_solana_unified_175b_in_global_usdt.webp\",\"author\":{\"name\":\"Solana Foundation\",\"avatar\":\"/uploads/authors/solanaLogoMark.svg\"},\"cursor\":\"solana-x-usdt0-case-study-2025\"},{\"id\":\"solana-breakpoint-2025\",\"published\":\"20 Dec 2025\",\"title\":\"Solana Breakpoint 2025: Convergence of State, Capital, and Code\",\"tags\":[\"Breakpoint\",\"Events\",\"Featured\"],\"categories\":[\"Finance\",\"Ecosystem\"],\"url\":\"/news/solana-breakpoint-2025\",\"description\":\"\\\"We ship in production. We ship at real scale, with real capital, and with a real community around us.\\\"  Solana's Breakpoint has been defined by distinct phases throughout the years. In 2025, the focus was primarily on Revenue.\",\"heroImage\":\"/uploads/posts/solana-breakpoint-2025/image1.webp\",\"author\":{\"name\":\"Solana Foundation\",\"avatar\":\"/uploads/authors/solanaLogoMark.svg\"},\"cursor\":\"solana-breakpoint-2025\"}]}]\n"])</script></body></html>