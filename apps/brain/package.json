{
	"name": "@waifufun/brain",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prebuild": "bun run --filter @waifufun/db build",
		"predev": "bun run --filter @waifufun/db build",
		"prestart": "bun run --filter @waifufun/db build",
		"pretypecheck": "bun run --filter @waifufun/db build",
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check src package.json tsconfig.json",
		"test": "node --import tsx --test test/**/*.test.ts",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@waifufun/db": "workspace:*",
		"pino": "^9.5.0",
		"twitter-api-v2": "^1.18.2"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	}
}
