# MongoDB Configuration
MONGO_URI="mongodb://localhost:27017/api-local"
# Redis Configuration
REDIS_PORT="6379"
REDIS_HOST="localhost"
REDIS_USERNAME="root"
REDIS_PASSWORD="dragonfly"
REDIS_DB="0"
# API Keys
ALCHEMY_API_KEY=""
HELIUS_API_KEY=""
# Optional Solana RPC override for NAV Solana spot enumeration (Helius recommended).
# Defaults to https://api.mainnet-beta.solana.com when unset.
SOLANA_RPC_URL=""
CODEX_API_KEY=""
# Cloudflare R2 (S3-compatible). For local dev against MinIO use the localhost
# endpoint instead. R2 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# PUBLIC_STORAGE_BASE_URL is the public-read URL (R2.dev hostname or your custom domain).
S3_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
PUBLIC_STORAGE_BASE_URL=https://<BUCKET>.<ACCOUNT_ID>.r2.dev
S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
S3_BUCKET_NAME=waifufun-storage
S3_REGION=auto
FAL_API_KEY=your_fal_key
#site
NEXT_PUBLIC_HOST=http://localhost:3000
JWT_SECRET=12345
NODE_ENV=development
API_URL=http://127.0.0.1:9000

# Frontend API URL (waifu-core backend)
# For local dev against waifu-core running locally:
# NEXT_PUBLIC_API_URL=http://localhost:3001
# For production against deployed waifu-core:
# NEXT_PUBLIC_API_URL=https://api.waifu.fun
NEXT_PUBLIC_API_URL=http://localhost:3001
# Feature flags
NEXT_PUBLIC_LAUNCHPAD_PICKER_ENABLED=false
# Testnet Solana Program
NEXT_PUBLIC_TOKEN_SUPPLY=1000000000000000
NEXT_PUBLIC_VIRTUAL_RESERVES=2800000000
NEXT_PUBLIC_CURVE_LIMIT=11300000000
NEXT_PUBLIC_DECIMALS=6
NEXT_PUBLIC_HELIUS_API_KEY=
DATABASE_URL= // for sync

# Eliza Cloud hosted agent provisioning (server-side only)
ELIZA_CLOUD_BASE_URL=https://elizacloud.ai
ELIZA_CLOUD_SERVICE_KEY=
ELIZAOS_CLOUD_API_KEY=
ELIZA_CLOUD_WAIFU_AGENT_IMAGE_URI=
WAIFU_CHAT_ACCESS_JWT_SECRET=
WEBHOOK_RECEIVER_SECRET=
ELIZA_CLOUD_WEBHOOK_URL=
ELIZA_CLOUD_WEBHOOK_SECRET=
WAIFU_ELIZA_CREDITS_SUCCESS_URL=
WAIFU_ELIZA_CREDITS_CANCEL_URL=
WAIFU_ENABLE_ELIZA_CLOUD_TEST_PAGE=false

# Live Eliza Cloud smoke harness. These are read by
# `npm run test:eliza-cloud:live` and should only be set for staging/live
# validation runs that intentionally create and control hosted cloud agents.
WAIFU_ELIZA_CLOUD_LIVE_SMOKE=0
WAIFU_API_BASE_URL=http://localhost:3100
WAIFU_ELIZA_SMOKE_TOKEN_ADDRESS=
# Optional alternative to WAIFU_ELIZA_SMOKE_AGENT_WALLET for local staging
# smoke only. The runner derives the EVM address locally and never sends the
# private key to waifu.fun or Eliza Cloud.
WAIFU_ELIZA_SMOKE_AGENT_PRIVATE_KEY=
# Optional smoke-only fallback that generates an ephemeral local private key
# and sends only the derived EVM address through the API.
WAIFU_ELIZA_SMOKE_GENERATE_AGENT_WALLET=0
WAIFU_ELIZA_SMOKE_AGENT_WALLET=
WAIFU_ELIZA_SMOKE_ADMIN_WALLET=
WAIFU_ELIZA_SMOKE_WALLET_KEY_REF=
WAIFU_ELIZA_SMOKE_REQUIRE_FULL_E2E=0
WAIFU_ELIZA_SMOKE_MODE=direct
WAIFU_ELIZA_SMOKE_ENQUEUE_WORKER=0
WAIFU_ELIZA_SMOKE_ENQUEUE_DRY_RUN=0
WAIFU_ELIZA_SMOKE_WAIT_SECONDS=180
WAIFU_ELIZA_SMOKE_STEWARD_BEARER=
WAIFU_ELIZA_SMOKE_OWNER_BEARER=
WAIFU_ELIZA_SMOKE_EXPECT_CHAT_ROLE=
WAIFU_ELIZA_SMOKE_TOP_UP=0
WAIFU_ELIZA_SMOKE_TOP_UP_CENTS=500
WAIFU_ELIZA_SMOKE_VERIFY_TOP_UP_SESSION=
WAIFU_ELIZA_SMOKE_VERIFY_LIFECYCLE_WEBHOOK=0

LAUNCH_GATE_ENABLED=true
LAUNCH_GATE_WALLETS=

# Supabase control plane (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

FLEEK_API_KEY=
# Pinata for ERC-8004 registration-file IPFS pins. Prefer PINATA_JWT.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
# Public API origin used in ERC-8004 HTTPS mirror URIs.
PUBLIC_API_BASE_URL=https://api.waifu.fun
# Optional PostgREST view name for token runtime overlays. Defaults to trying:
# waifufun_token_runtime_overlay, token_runtime_overlay, token_runtime_overlays
SUPABASE_TOKEN_RUNTIME_VIEW=

GENERATION_IMAGE_MIN_BALANCE=50
GENERATION_IMAGE_MIN_BALANCE_FAST=50
NEXT_PUBLIC_GENERATION_IMAGE_MIN_BALANCE=50
NEXT_PUBLIC_GENERATION_IMAGE_MIN_BALANCE_FAST=50
GENERATION_VIDEO_MIN_BALANCE=50
GENERATION_VIDEO_MIN_BALANCE_FAST=50
NEXT_PUBLIC_GENERATION_VIDEO_MIN_BALANCE=50
NEXT_PUBLIC_GENERATION_VIDEO_MIN_BALANCE_FAST=50
NEXT_PUBLIC_NETWORK=mainnet

# -----------------------------------------------------------------------------
# Launch critical path (waifu-core API + Flap launch rail)
# -----------------------------------------------------------------------------
# REQUIRED for POST /v2/launches and the Flap adapter (the only live BSC launch
# rail). Without LAUNCH_FACTORY_ADDRESS the launch service returns
# LAUNCH_SERVICE_UNAVAILABLE / FACTORY_ADDRESS_UNSET; without
# WAIFU_PLATFORM_FEE_WALLET the Flap adapter throws FlapNotConfigured.
LAUNCH_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
LAUNCH_FACTORY_SIGNER_PK=
WAIFU_PLATFORM_FEE_WALLET=0x0000000000000000000000000000000000000000

# domain of production site
CORS_DOMAINS=

# -----------------------------------------------------------------------------
# Waifu-core backend (@waifu/* apps: API, worker, evm-indexer, brain)
# -----------------------------------------------------------------------------
# Canonical full template: README.waifu-core.md (migrated verbatim from waifu-core).
# CI defaults: see .env.ci | API integration tests: .env.test.example
# Minimal local deps: docker/docker-compose.deps.yml (Postgres + Redis)
