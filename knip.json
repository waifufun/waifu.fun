{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"rules": {
		"exports": "off",
		"nsExports": "off",
		"types": "off",
		"nsTypes": "off",
		"enumMembers": "off",
		"duplicates": "off"
	},
	"ignoreDependencies": ["@semantic-release/github"],
	"workspaces": {
		".": {
			"ignoreFiles": ["apps/.frontend-static-export-stash/**", "probe/**/*.cjs", "scripts/**/*.ts"]
		},
		"apps/frontend": {
			"entry": ["workers/**/*.ts"],
			"ignoreFiles": ["functions/[[path]].js"],
			"ignoreDependencies": ["buffer"]
		},
		"packages/agent-actions": {
			"ignoreFiles": ["test/**/*.test.ts"]
		},
		"packages/contracts-evm": {
			"entry": ["scripts/**/*.js", "test/**/*.js"],
			"ignoreDependencies": ["@openzeppelin/contracts", "@openzeppelin/contracts-upgradeable"]
		},
		"packages/contracts-solana/autofun-sc-audit": {
			"entry": ["tests/**/*.ts"],
			"ignoreBinaries": ["anchor"]
		},
		"packages/rpc": {
			"ignoreFiles": ["src/evm/types/WaifuFunToken.ts", "src/evm/types/WaifuFunTokenFactory.ts"]
		},
		"packages/flap": {
			"ignoreDependencies": ["tsx"]
		},
		"packages/launchpad": {
			"ignoreDependencies": ["tsx"]
		}
	}
}
